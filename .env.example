# ─────────────────────────────────────────────────────────────────────────────
# Eight — environment variables
#
# Copy this file to `.env.local` and fill in the values:
#     cp .env.example .env.local
#
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser. The
# contact form is fully static (no backend), so it submits to a third-party
# form endpoint. Formspree is the default; any compatible endpoint works.
# ─────────────────────────────────────────────────────────────────────────────

# Formspree form endpoint for the contact form.
# 1. Create a free form at https://formspree.io
# 2. Copy the form's endpoint URL (looks like https://formspree.io/f/abcdwxyz)
# 3. Paste it below.
#
# If this is left blank, the contact form gracefully falls back to opening the
# visitor's email client (mailto:info@8-holding.com) instead.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# The canonical site URL. Used for SEO metadata, sitemap, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://www.8-holding.com
